# =====================================================================
# Rhythm Arena Online - Configuración de ejemplo
# Copia este archivo como ".env" y ajusta los valores.
# =====================================================================

# ---- Servidor ----------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Pon "true" si el servidor está detrás de un proxy inverso (Nginx, Render,
# Railway, Heroku...) para leer la IP real desde X-Forwarded-For.
TRUST_PROXY=false

# Orígenes permitidos por CORS / Socket.IO, separados por comas.
# Usa "*" solo en desarrollo.
CORS_ORIGIN=http://localhost:3000

# ---- Protección contra abuso ------------------------------------------
# Conexiones simultáneas máximas por IP
MAX_CONNECTIONS_PER_IP=10
# Límite general de eventos por socket (cubo de tokens)
RATE_LIMIT_BURST=30
RATE_LIMIT_PER_SEC=10
# Límite específico para actualizaciones de puntuación (game:score)
GAME_RATE_LIMIT_PER_SEC=20

# ---- Salas -------------------------------------------------------------
MAX_PLAYERS_PER_ROOM=4
MIN_PLAYERS_TO_START=2
ROOM_CODE_LENGTH=5
MAX_ROOMS=1000
# Cuenta atrás antes de empezar la canción (ms)
COUNTDOWN_MS=5000
# Tiempo extra tras la duración de la canción antes de cerrar la partida (ms)
FINISH_GRACE_MS=10000
# Frecuencia de envío del marcador en vivo (ms)
SCOREBOARD_INTERVAL_MS=250
# Tiempo que sobrevive una sala terminada antes de cerrarse (ms)
RANKED_ROOM_TTL_MS=60000
CASUAL_ROOM_TTL_MS=600000

# ---- Rating (en memoria; se pierde al reiniciar el servidor) -----------
INITIAL_RATING=1000
RATING_K_FACTOR=32
MAX_PROFILES=5000

# ---- Matchmaking -------------------------------------------------------
MATCHMAKING_TICK_MS=1000
# Ventana inicial de rating y crecimiento por segundo de espera
MATCHMAKING_BASE_WINDOW=100
MATCHMAKING_WINDOW_GROWTH_PER_SEC=25
MATCHMAKING_MAX_WINDOW=1500
# Tamaño de partida y mínimo para aceptar una partida parcial
MATCHMAKING_MATCH_SIZE=4
MATCHMAKING_MIN_PLAYERS=2
# Tras cuántos ms de espera se acepta una partida con menos jugadores
MATCHMAKING_PARTIAL_AFTER_MS=15000
# Tiempo máximo en cola antes de cancelar la búsqueda
MATCHMAKING_MAX_QUEUE_MS=120000

# Canciones disponibles para partidas clasificatorias.
# Formato: id|dificultad|duracionMs|totalNotas ; id|dificultad|duracionMs|totalNotas
# Dificultades: easy, normal, hard, expert.
# IMPORTANTE: duracionMs y totalNotas deben coincidir con el chart real.
# Si queda vacío, el matchmaking clasificatorio se deshabilita.
RANKED_SONGS=neon-pulse|normal|120000|480;cyber-drift|hard|150000|720
